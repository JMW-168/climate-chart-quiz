{
  "name": "climate-chart-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:author": "tsx scripts/author-demo-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:build": "tsx scripts/build-content.ts",
    "icons": "tsx scripts/make-icons.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "npm run content:build && npm run typecheck && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
